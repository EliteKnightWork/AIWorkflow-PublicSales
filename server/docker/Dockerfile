FROM ruby:3.3.1

WORKDIR /app

ARG SHARED_DIR=/tmp/downloads
VOLUME ["${SHARED_DIR}"]

RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    nodejs \
    unar \
    poppler-utils \
    catdoc \
    antiword

COPY Gemfile Gemfile.lock ./
RUN bundle install --jobs=4

COPY . .

ARG RAILS_ENV
ARG RAILS_MASTER_KEY
ARG PROJECT_BUCKET_NAME
ARG SQS_ENDPOINT
ARG PROPOSAL_QUEUE_URL
ARG PROJECT_BUCKET_REGION
ARG ELASTICSEARCH_CLOUD_ID
ARG ELASTICSEARCH_USER
ARG ELASTICSEARCH_PASSWORD
ARG RAILS_LOG_TO_STDOUT
ARG CLIENT_ORIGIN
ARG ADMIN_CLIENT_ORIGIN
ARG REDESIGN_CLIENT_ORIGIN

ENV RAILS_MASTER_KEY=${RAILS_MASTER_KEY}
ENV RAILS_ENV=${RAILS_ENV}
ENV PROJECT_BUCKET_NAME=${PROJECT_BUCKET_NAME}
ENV SQS_ENDPOINT=${SQS_ENDPOINT}
ENV PROPOSAL_QUEUE_URL=${PROPOSAL_QUEUE_URL}
ENV PROJECT_BUCKET_REGION=${PROJECT_BUCKET_REGION}
ENV ELASTICSEARCH_CLOUD_ID=${ELASTICSEARCH_CLOUD_ID}
ENV ELASTICSEARCH_USER=${ELASTICSEARCH_USER}
ENV ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_PASSWORD}
ENV RAILS_LOG_TO_STDOUT=${RAILS_LOG_TO_STDOUT}
ENV CLIENT_ORIGIN=${CLIENT_ORIGIN}
ENV ADMIN_CLIENT_ORIGIN=${ADMIN_CLIENT_ORIGIN}
ENV REDESIGN_CLIENT_ORIGIN=${REDESIGN_CLIENT_ORIGIN}

# スクレイピングのヘッドレスモード設定
ENV HEADLESS=1

COPY ./docker/entrypoint.sh /usr/bin/
RUN chmod +x /usr/bin/entrypoint.sh
# RUN chmod +x ./docker/entrypoint.sh
ENTRYPOINT ["entrypoint.sh"]

EXPOSE 3000
CMD ["rails", "server", "-b", "0.0.0.0"]
