create_table :projects, charset: 'utf8mb4', collation: 'utf8mb4_0900_ai_ci', force: :cascade do |t|
  t.string :uuid, null: false, comment: 'UUID(Labid側で採番したキー)'
  t.string :ulid, comment: 'ULID(ルーター側で採番したキー)'
  t.string :key, null: false, comment: '公告情報のキー(取得元で採番されたキー)'
  t.string :title, null: false, comment: '件名', renamed_from: 'project_name'
  t.string :raw_title, comment: '整形前の件名'
  t.text :description, size: :long, comment: '公告文', renamed_from: 'project_description'
  t.text :summary, null: true, comment: '案件詳細の要約', size: :long
  t.string :organization_name, comment: '発注機関名'
  t.references :organization, null: true, foreign_key: true, comment: '発注機関ID'
  t.string :lg_code, comment: '都道府県コード'
  t.string :prefecture_name, comment: '都道府県名'
  t.string :city_code, comment: '市区町村コード'
  t.string :city_name, comment: '市区町村'
  t.string :procedure_type, comment: '入札方式'
  t.string :procedure_type_group, comment: '入札方式グループ'
  t.string :source, null: false, comment: '公告情報の取得元'
  t.text :external_document_url, null: true, comment: '公告情報のURL', renamed_from: 'external_document_uri'
  # TODO: NOT NULL制約を追加する
  t.date :publication_date, comment: '公告日', renamed_from: 'cft_issue_date'
  t.date :registration_date, null: false, comment: '登録日', renamed_from: 'date'
  t.date :briefing_session_date, comment: '入札説明会日'
  t.date :application_document_deadline_date, comment: '応募書類提出期日', renamed_from: 'document_deadline_date'
  t.date :proposal_document_deadline_date, comment: '提案書類提出期日'
  t.date :bidding_deadline_date, comment: '入札日', renamed_from: 'tender_submission_deadline'
  t.date :tender_opening_date, comment: '開札日', renamed_from: 'opening_tenders_event'
  t.date :delivery_deadline_date, comment: '納入期限日', renamed_from: 'period_end_time'
  t.boolean :is_backfilled, null: false, default: false, comment: '過去分取り込みによるデータかどうか'
  t.datetime :hidden_at, null: true, comment: '非表示日時'
  t.string :participation_qualification, comment: '参加資格'
  t.boolean :is_experience_required, null: false, default: false, comment: '実績が必要かどうか'
  t.boolean :is_office_required, null: true, comment: '事業所が必要かどうか'
  t.bigint :planned_price, comment: '予定価格'
  t.text :keywords, comment: 'キーワード'
  t.string :processing_status, default: 'pending', comment: '処理状況 (pending, processing_documents, processing_summary, completed, failed)'
  t.references :company_project, null: true, foreign_key: true, comment: '企業プロジェクトID'
  t.datetime :created_at, null: false
  t.datetime :updated_at, null: false

  t.index [:uuid], unique: true
  t.index [:key, :source], unique: true
  t.index [:lg_code]
  t.index [:city_code]
  t.index [:title]
  t.index [:raw_title]
  t.index [:organization_name]
  t.index [:bidding_deadline_date]
  t.index [:application_document_deadline_date]
  t.index [:proposal_document_deadline_date]
  t.index [:registration_date]
  t.index [:hidden_at]
  t.index [:updated_at]
end

